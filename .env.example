# =============================================================================
# Trading Bot Crypto + AI — Environment Variables
# =============================================================================
# Copiar este archivo como .env y completar con valores reales:
#   cp .env.example .env
#
# NUNCA commitear el archivo .env al repositorio.
# =============================================================================

# --- Modo de ejecución ---
BOT_MODE=paper                          # paper | live
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# --- Base de datos ---
DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot
DATABASE_ECHO=false                     # true para ver queries SQL en logs
# docker-compose arma DATABASE_URL con estas tres (POSTGRES_PASSWORD es obligatoria).
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=
POSTGRES_DB=trading_bot

# --- Exchange principal (CCXT) ---
EXCHANGE_ID=binance                     # binance | bybit | okx | bitget
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true                   # true = testnet, false = producción

# Pares de trading
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# Descarga de velas: reintentos acotados (backoff exponencial + jitter) y
# timeout total por fetch, para que una caída del exchange no bloquee el ciclo.
OHLCV_FETCH_MAX_RETRIES=5
OHLCV_FETCH_TIMEOUT_S=60

# --- Datos de mercado ---
COINGECKO_API_KEY=                      # Opcional (free tier funciona sin key, 30 calls/min)
CRYPTOCOMPARE_API_KEY=                  # Gratis en cryptocompare.com (100 calls/h)

# --- Risk Management ---
# Fase 1 calibrada (README "Tamaño de posición"): el riesgo fija el tamaño y el
# tope solo actúa de respaldo. Con 1.0 / 10.0 el tope fijaba ~100 % de las entradas.
MAX_RISK_PER_TRADE_PCT=0.20             # % del portfolio arriesgado si salta el stop ATR x2
MAX_POSITION_PCT=25.0                   # tope por posición; en donchian_ensemble, asignación por par
MAX_DRAWDOWN_PCT=15.0                   # Kill-switch: liquidar y HALT permanente si drawdown >= X%
MAX_DAILY_LOSS_PCT=3.0                  # Liquidar y pausar entradas hasta el próximo día UTC si pérdida diaria >= X%

# Estado de riesgo persistido (pico, pausa/halt, stops por par). {mode} = BOT_MODE,
# así una sesión paper nunca pisa el estado de live. Escritura atómica.
RISK_STATE_PATH=var/state/risk_state_{mode}.json
# Reset manual del HALT por drawdown: arrancar UNA vez con RISK_RESET=true
# (re-baselinea el pico al balance actual) y luego volver a false.
# Alternativa: detener el bot y borrar el archivo de RISK_STATE_PATH.
RISK_RESET=false

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=                     # Obtener de @BotFather en Telegram
TELEGRAM_CHAT_ID=                       # ID del chat donde enviar alertas

# =============================================================================
# AI — Feature Flags (activar progresivamente)
# =============================================================================

# --- Capa 1: Sentiment Analysis ---
USE_SENTIMENT=false
SENTIMENT_MODEL=ElKulako/cryptobert    # ElKulako/cryptobert | kk08/CryptoBERT | ProsusAI/finbert | burakutf/finetuned-finbert-crypto
SENTIMENT_WEIGHT=0.2                    # Peso en signal combiner (0.0 - 1.0)
SENTIMENT_INTERVAL_MIN=15              # Frecuencia de análisis en minutos

# --- Capa 2: LLM Multi-Agent ---
USE_LLM_AGENT=false
LLM_PROVIDER=anthropic                  # anthropic | openai | ollama
LLM_MODEL=claude-haiku-4-5-20251001    # claude-haiku-4-5-20251001 | gpt-4o-mini | llama3
LLM_WEIGHT=0.2
LLM_ANALYSIS_INTERVAL_MIN=15
LLM_MAX_DAILY_COST_USD=5.0             # Circuit breaker: pausar LLM si costo diario > X

# API Keys LLM
ANTHROPIC_API_KEY=                      # Para Claude (anthropic.com)
OPENAI_API_KEY=                         # Para GPT (platform.openai.com)
OLLAMA_BASE_URL=http://localhost:11434  # Para modelos locales

# --- Capa 3: Machine / Deep Learning Prediction ---
USE_DL_PREDICTION=false
DL_MODEL_TYPE=lightgbm                  # solo lightgbm está implementado (gru/cnn_lstm son stubs: desactivan ML)
ML_MODEL_DIR=var/models/prediction      # un modelo por par: {ML_MODEL_DIR}/BTC_USDT_1h.pkl (+ .sha256)
DL_WEIGHT=0.2
DL_RETRAIN_DAYS=14                      # Reentrenar modelo cada X días
DL_LOOKBACK_BARS=168                    # Ventana de input (168 = 7 días en barras horarias)

# --- Capa 4: Reinforcement Learning ---
USE_RL_AGENT=false
RL_ALGORITHM=PPO                        # PPO | DQN | A2C

# --- Signal Combiner ---
TECHNICAL_WEIGHT=0.4                    # Peso de señales técnicas (siempre el mayor)
MIN_CONFIDENCE_THRESHOLD=0.5            # No operar si confianza < X

# =============================================================================
# Datos sociales (opcionales, para sentiment analysis)
# =============================================================================
TWITTER_BEARER_TOKEN=                   # Twitter/X API v2
REDDIT_CLIENT_ID=                       # Reddit API
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trading-bot/1.0

# =============================================================================
# Infraestructura (producción)
# =============================================================================
PROMETHEUS_ENABLED=false
